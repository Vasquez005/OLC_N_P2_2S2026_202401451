digraph AST {
    graph [fontname="Helvetica", ordering=out, nodesep=0.3, ranksep=0.45];
    node  [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=11, fillcolor="#eef2ff", color="#6366f1"];
    edge  [fontname="Helvetica", fontsize=9, color="#64748b", fontcolor="#64748b"];
    n1 [label="Program", fillcolor="#e0e7ff", color="#4338ca"];
    n2 [label="Function\nnombre: main", fillcolor="#e0e7ff", color="#4338ca"];
    n3 [label="Block", fillcolor="#e0e7ff", color="#4338ca"];
    n4 [label="VarDecl\nnombre: numeros\ntipo: [i32; 3]"];
    n5 [label="ArrayLiteral\n⟶ [i32; 3]"];
    n6 [label="Literal\nvalor: 10\ntipo: i32", fillcolor="#ecfdf5", color="#059669"];
    n5 -> n6 [label="elementos[0]"];
    n7 [label="Literal\nvalor: 20\ntipo: i32", fillcolor="#ecfdf5", color="#059669"];
    n5 -> n7 [label="elementos[1]"];
    n8 [label="Literal\nvalor: 30\ntipo: i32", fillcolor="#ecfdf5", color="#059669"];
    n5 -> n8 [label="elementos[2]"];
    n4 -> n5 [label="valor"];
    n3 -> n4 [label="instrucciones[0]"];
    n9 [label="Print\nformato: \"Primer n\\xfamero: {}\""];
    n10 [label="Index\n⟶ i32"];
    n11 [label="Identifier\nnombre: numeros\n⟶ [i32; 3]", fillcolor="#ecfdf5", color="#059669"];
    n10 -> n11 [label="base"];
    n12 [label="Literal\nvalor: 3\ntipo: i32", fillcolor="#ecfdf5", color="#059669"];
    n10 -> n12 [label="indice"];
    n9 -> n10 [label="args"];
    n3 -> n9 [label="instrucciones[1]"];
    n2 -> n3 [label="cuerpo"];
    n1 -> n2 [label="funciones"];
}