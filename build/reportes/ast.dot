digraph AST {
    graph [fontname="Helvetica", ordering=out, nodesep=0.3, ranksep=0.45];
    node  [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=11, fillcolor="#eef2ff", color="#6366f1"];
    edge  [fontname="Helvetica", fontsize=9, color="#64748b", fontcolor="#64748b"];
    n1 [label="Program", fillcolor="#e0e7ff", color="#4338ca"];
    n2 [label="Function\nnombre: main", fillcolor="#e0e7ff", color="#4338ca"];
    n3 [label="Block", fillcolor="#e0e7ff", color="#4338ca"];
    n4 [label="VarDecl\nnombre: x"];
    n5 [label="Literal\nvalor: 5\ntipo: i32", fillcolor="#ecfdf5", color="#059669"];
    n4 -> n5 [label="valor"];
    n3 -> n4 [label="instrucciones[0]"];
    n6 [label="Print\nformato: \"x = {}\""];
    n7 [label="BinaryOp\nop: *\n⟶ i32", fillcolor="#ecfdf5", color="#059669"];
    n8 [label="Identifier\nnombre: x\n⟶ i32", fillcolor="#ecfdf5", color="#059669"];
    n7 -> n8 [label="izq"];
    n9 [label="Literal\nvalor: 2\ntipo: i32", fillcolor="#ecfdf5", color="#059669"];
    n7 -> n9 [label="der"];
    n6 -> n7 [label="args"];
    n3 -> n6 [label="instrucciones[1]"];
    n2 -> n3 [label="cuerpo"];
    n1 -> n2 [label="funciones"];
}